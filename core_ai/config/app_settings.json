{
  "general": {
    "animations": true,
    "enableHinglish": true,
    "language": "en-US",
    "secondaryLanguage": "hi-IN",
    "startOnBoot": true,
    "theme": "dark"
  },
  "security": {
    "apiKeys": {
      "googleGemini": "",
      "openAI": "",
      "anthropic": "",
      "elevenLabs": ""
    },
    "permissions": {
      "allowFileDeletion": false,
      "allowAppExecution": true,
      "allowWebBrowsing": true,
      "allowSystemControl": true
    },
    "encryption": {
      "encryptDatabase": true,
      "enablePinParams": false
    }
  },
  "ai": {
    "contextWindow": 4096,
    "defaultModel": "gemini-2.5-flash",
    "defaultProvider": "gemini",
    "localLlm": {
      "enabled": true,
      "modelPath": "models/pulsar-final-q4_k_m.gguf",
      "useGpu": false
    },
    "maxTokens": 2048,
    "safetySettings": {
      "dangerousContent": "block_none",
      "harassment": "block_none",
      "hateSpeech": "block_none",
      "sexuallyExplicit": "block_none"
    },
    "temperature": 0.7
  },
  "voice": {
    "stt": {
      "continuous": true,
      "enabled": true,
      "engine": "whisper",
      "language": "hi-IN",
      "model": "whisper-small",
      "noise_reduction": true
    },
    "tts": {
      "enabled": true,
      "engine": "kittentts",
      "pitch": 1,
      "speed": 1.0,
      "voice_id": "kitten:Bella",
      "voice_name": "Bella (Offline KittenTTS)",
      "volume": 0.9
    },
    "wakeWord": {
      "enabled": true,
      "phrases": [
        "hey pulsar",
        "pulsar",
        "ok pulsar",
        "hey assistant"
      ],
      "sensitivity": 0.6
    }
  },
  "automation": {
    "autoUpdate": true,
    "autoBackup": "weekly",
    "maxHistorySize": 1000,
    "smartHome": {
      "enabled": false,
      "provider": "none"
    }
  },
  "system": {
    "logLevel": "INFO",
    "maxLogSizeMb": 10,
    "minimizeToTray": true,
    "desktopOverlay": true,
    "notifications": {
      "desktop": true,
      "sound": true
    }
  }
}
